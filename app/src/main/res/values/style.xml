<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SensorStyle" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/gray</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">10dp</item>
    </style>
    <style name="ButtonStyle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">50dp</item>
        <item name="android:layout_height">50dp</item>
        <item name="strokeColor">@color/black</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">48dp</item>
        <item name="android:paddingVertical">1dp</item>
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>

        <item name="cornerRadius">10dp</item>
        <item name="android:maxWidth">50dp</item>
        <item name="android:maxHeight">50dp</item>
    </style>

</resources>